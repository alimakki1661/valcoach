HDEV_KEY=your_henrikdev_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.8-flash
# Optional: tried once if the primary model fails all retries
LLM_FALLBACK_MODEL=gemini-3.7-flash
MATCH_SIZE=20
PORT=3001
# Set to your Netlify site URL in production (e.g. https://your-site.netlify.app)
ALLOWED_ORIGIN=https://your-netlify-site.netlify.app
